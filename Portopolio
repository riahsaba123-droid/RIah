<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Sabariah, S.A.B | Healthcare Specialist & Data Support</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #F8FAFC; --card: #FFFFFF; --border: #E2E8F0; --text: #0F172A;
      --muted: #64748B; --blue: #2563EB; --blue-soft: #EFF6FF; --radius: 12px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; letter-spacing: -0.01em; }
    body { background: var(--bg); color: var(--text); padding-bottom: 74px; }
    @media (min-width: 860px) { body { padding-bottom: 0; } }
    .container { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
    
    /* Navbar */
    .top-nav { position: sticky; top: 0; z-index: 100; height: 64px; background: rgba(255,255,255,0.92); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); display: flex; align-items: center; }
    .nav-inner { display: flex; justify-content: space-between; align-items: center; width: 100%; }
    .brand { display: flex; align-items: center; gap: 10px; cursor: pointer; }
    .brand img { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; background: var(--border); }
    .nav-links { display: flex; gap: 4px; list-style: none; }
    .nav-btn { background: none; border: none; font-size: 0.8rem; font-weight: 500; color: var(--muted); padding: 7px 11px; border-radius: 6px; cursor: pointer; transition: 0.15s; }
    .nav-btn:hover, .nav-btn.active { color: var(--blue); background: var(--blue-soft); font-weight: 600; }
    
    /* Bottom Bar Mobile */
    .bottom-bar { display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; height: 60px; background: #FFF; border-top: 1px solid var(--border); }
    .bottom-inner { display: flex; justify-content: space-around; align-items: center; height: 100%; }
    .tab-btn { background: none; border: none; font-size: 0.68rem; font-weight: 500; color: var(--muted); cursor: pointer; }
    .tab-btn.active { color: var(--blue); font-weight: 700; }
    @media (max-width: 859px) { .nav-links { display: none; } .bottom-bar { display: block; } }

    /* UI Components */
    .spa-view { display: none; animation: fadeIn 0.2s ease forwards; padding: 32px 0 50px; }
    .spa-view.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
    
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; font-size: 0.82rem; font-weight: 600; border-radius: 8px; cursor: pointer; text-decoration: none; border: 1px solid transparent; }
    .btn-blue { background: var(--blue); color: #FFF; }
    .btn-outline { background: #FFF; color: var(--text); border-color: var(--border); }
    .btn-sm { padding: 6px 12px; font-size: 0.75rem; }
    
    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 18px; margin-top: 20px; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; justify-content: space-between; }
    .badge { font-size: 0.7rem; font-weight: 600; color: var(--blue); background: var(--blue-soft); padding: 3px 8px; border-radius: 4px; width: fit-content; }
    
    /* Hero */
    .hero { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 40px; align-items: center; padding: 30px 0; }
    .hero img { width: 100%; max-width: 300px; height: 360px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--border); }
    .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 16px 0; }
    .tag { font-size: 0.72rem; font-weight: 600; background: #FFF; border: 1px solid var(--border); padding: 4px 10px; border-radius: 6px; }
    @media (max-width: 860px) { .hero { grid-template-columns: 1fr; text-align: center; } .hero img { margin: 0 auto; order: -1; } .tags, .hero-btns { justify-content: center; display: flex; } }

    /* Modals & Toast */
    .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 200; align-items: center; justify-content: center; padding: 16px; }
    .modal-box { background: #FFF; border-radius: var(--radius); max-width: 440px; width: 100%; padding: 24px; position: relative; }
    .toast { position: fixed; bottom: 20px; right: 20px; background: var(--text); color: #FFF; padding: 10px 16px; border-radius: 8px; font-size: 0.8rem; z-index: 300; display: none; }
  </style>
</head>
<body>

  <!-- Sticky Navbar -->

      <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=https%3A%2F%2Fwa.me%2F6285202088185" alt="QR" style="margin:0 auto; display:block;">
      <p style="font-size:0.85rem; font-weight:700; color:var(--blue); margin-top:12px;">+62 852-0208-8185</p>
    </div>
  </div>

  <div id="toast" class="toast">Pesan berhasil dikirim!</div>

  <script>
    const DATA = [
      { cat: "cert", sub: "Hong Kong (CNA)", t: "CNA (HK): First Aid & CPR with AED", org: "St. John / CNA HK", d: "Respon darurat, resusitasi jantung paru (CPR), dan penggunaan AED terakreditasi.", url: "https://drive.google.com/file/d/1EiZkyv7M0ZPH2_Iw6HGG5G2o_-0N9tS1/view?usp=sharing" },
      { cat: "cert", sub: "UK (City & Guilds)", t: "City & Guilds: Assured Caregiving", org: "City & Guilds UK", d: "Standar perawatan medis lansia komprehensif, etika klinis, dan keselamatan pasien.", url: "https://drive.google.com/file/d/1Nvz60A5ee8YZ1tTEJ-UK9E5-IVpbNMiI/view?usp=sharing" },
      { cat: "cert", sub: "USA (ACA)", t: "ACA: National Caregiver Certificate", org: "American Caregiver Assoc.", d: "Standar asistensi kehidupan sehari-hari (ADL) dan pendampingan geriatri.", url: "https://drive.google.com/drive/folders/1160N50H0FluMb3WtCechbms4oaWEh9QJ?usp=drive_link" },
      { cat: "cert", sub: "USA (ASHI)", t: "ASHI: Adult CPR & AED Card", org: "ASHI USA", d: "Kualifikasi respon darurat dewasa, protokol CPR, dan sertifikasi resmi ASHI.", url: "https://drive.google.com/file/d/13i9nMlJk-WshDOJ4moQhoFqnYx9WGCyM/view?usp=drive_link" },
      { cat: "cert", sub: "UK (TQUK)", t: "TQUK: Caregiving Level 2", org: "TQUK (Ofqual UK)", d: "Perawatan klinis lansia tingkat lanjut, demensia, dan pemantauan nutrisi pasien.", url: "https://drive.google.com/file/d/1oyCAakZ2VLD-tG0DZeowXxQU9JDTl4C3/view?usp=drive_link" },
      
      { cat: "exp", sub: "Live-in Care", t: "Caregiver Dubai LIVE IN", org: "Dubai Residence (2016-2018)", d: "Perawatan lansia intensif, jadwal obat presisi, tanda vital, dan pendampingan mobilitas.", url: "" },
      { cat: "exp", sub: "Live-in & Telehealth", t: "Hong Kong Live-in & Virtual Care", org: "Hong Kong (2025-Present)", d: "Perawatan komprehensif (tensi, luka diabetes, kursi roda) & koordinasi telehealth.", url: "" },
      { cat: "exp", sub: "Volunteering", t: "Volunteer Assistant Teacher Computer", org: "YMCA Hong Kong (2025-Present)", d: "Pengajaran literasi komputer dan keamanan digital komunitas pekerja migran.", url: "https://drive.google.com/drive/folders/194GLEHT8K5H4SOqa_Ov7OpGtgasaxaHG?usp=drive_link" },
      { cat: "exp", sub: "Training", t: "Trainer Computer & Literasi Data", org: "UTLLN HK (2025-Present)", d: "Instruktur analisis spreadsheet dan Microsoft Office lanjutan bagi mahasiswa.", url: "https://drive.google.com/file/d/1OsrXfLN9PjqgeVBA-C1bGsF5eAvArmvA/view?usp=drive_link" },

      { cat: "trainer", sub: "BNSP Data", t: "BNSP Data Analyst", org: "BNSP Indonesia", d: "Standar kompetensi pembersihan data, visualisasi analitik, dan perumusan rekomendasi.", url: "https://drive.google.com/file/d/1ZbEUqKULJR-AaR39N9IZoBm2DVrmZhXJ/view?usp=sharing" },
      { cat: "trainer", sub: "BNSP Office", t: "BNSP Microsoft Office", org: "BNSP Indonesia", d: "Otomatisasi pengolahan dokumen, tabel terpadu, dan administrasi perkantoran efisien.", url: "https://drive.google.com/file/d/1HTuzbpKkjTbwbM973j2Ui6aekKHsCTXa/view?usp=sharing" },
      { cat: "trainer", sub: "Data Specialist", t: "Excel & Data Entry Specialist", org: "Lembaga Sertifikasi", d: "Validasi dataset masal, formula analitis, dan standarisasi formulir kesehatan.", url: "https://drive.google.com/file/d/1H00PWw93cdfNojYdurA8KJ6Bcrdawqzl/view?usp=drive_link" },
      { cat: "trainer", sub: "Kualitas & K3", t: "ISO 9001 & Fire Safety HK", org: "QMS & HK Safety Standard", d: "Manajemen mutu terstruktur dan mitigasi keselamatan kebakaran gedung bertingkat.", url: "https://drive.google.com/file/d/1GmB7exv4iFeaZG3YdsaE3qj0QIfj-ORP/view?usp=drive_link" },

      { cat: "lead", sub: "Alumni Association", t: "Ketua Bidang IKAUT Cabang HK", org: "IKAUT Hong Kong (2024-Present)", d: "Menggerakkan pelatihan IT, pengabdian masyarakat, dan program jejaring alumni.", url: "https://drive.google.com/file/d/1Cf7T1WFzygzEu0IWXPgYNd2SDEvTehlu/view?usp=drive_link" },
      { cat: "lead", sub: "Advokasi", t: "Penggerak Literasi Digital Komunitas", org: "Komunitas Migran HK", d: "Inisiator pelatihan komputer dan kolaborasi riset produktif diaspora.", url: "https://drive.google.com/file/d/1zuCOEcJbIJAzc2GW2Z4cAQsc96ygqiZ3/view?usp=drive_link" },

      { cat: "edu", sub: "Strata 1", t: "Sarjana Administrasi Bisnis (S.A.B)", org: "Universitas Terbuka (UTLLN HK)", d: "Spesialisasi Sistem Informasi dan Manajemen Operasional dengan Ijazah Apostille Kemenkumham.", url: "https://drive.google.com/drive/folders/160pS-gFkXw-DB6O9idJPxzotZp1ypKH2?usp=drive_link" },

      { cat: "proj", sub: "Kesehatan", t: "Caregiving Daily Report Templates", org: "Sistem Operasional", d: "Pencatatan tanda vital pasien lansia, jadwal obat, dan komunikasi dokter.", url: "https://drive.google.com/file/d/1jxfGAUKXnccdu8ePX0Q5l2hVZmZ3iut_/view?usp=sharing" },
      { cat: "proj", sub: "Data Dashboards", t: "Health Data Dashboard (Power BI)", org: "Healthcare Analytics", d: "Visualisasi tren tekanan darah berkala dan jadwal telehealth interaktif.", url: "https://drive.google.com/file/d/1T7BL4JIPKBieea1tOhkgMN1KPEkcF8yH/view?usp=drive_link" },
      { cat: "proj", sub: "Web Platform", t: "Website Resmi IKA – UTLLN HK", org: "Portal Alumni Terpadu", d: "Direktori beasiswa, materi pelatihan, dan pusat informasi komunitas.", url: "https://ikauthk.srh.ai.id/" },
      { cat: "proj", sub: "Publikasi Ilmiah", t: "Jurnal Manajemen (Sinta 4, 2025)", org: "Publikasi Ilmiah", d: "Karya ilmiah strategi pemasaran produk edukasi digital pada platform online.", url: "https://penerbitadm.pubmedia.id/index.php/JER/article/view/2630" }
    ];

    function goView(viewId) {
      document.querySelectorAll('.spa-view').forEach(v => v.classList.remove('active'));
      const target = document.getElementById(viewId);
      if (target) target.classList.add('active');

      document.querySelectorAll('.nav-btn, .tab-btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-t') === viewId);
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function toggleModal(id, open) {
      document.getElementById(id).style.display = open ? 'flex' : 'none';
    }

    function renderCards() {
      const map = { cert: 'grid-cert', exp: 'grid-exp', trainer: 'grid-trainer', lead: 'grid-lead', edu: 'grid-edu', proj: 'grid-proj' };
      DATA.forEach(d => {
        const wrap = document.getElementById(map[d.cat]);
        if (!wrap) return;
        const btn = d.url ? `<a href="${d.url}" target="_blank" class="btn btn-outline btn-sm" style="margin-top:14px; width:100%; justify-content:center;">Buka Dokumen</a>` : '';
        wrap.innerHTML += `
          <div class="card">
            <div>
              <span class="badge">${d.sub}</span>
              <h3 style="font-size:0.96rem; font-weight:700; margin:8px 0 2px;">${d.t}</h3>
              <p style="font-size:0.75rem; color:var(--muted); margin-bottom:8px;">${d.org}</p>
              <p style="font-size:0.82rem; color:#475569; line-height:1.5;">${d.d}</p>
            </div>
            ${btn}
          </div>
        `;
      });
    }

    function sendMsg(e) {
      e.preventDefault();
      const toast = document.getElementById('toast');
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 3000);
      e.target.reset();
    }

    document.addEventListener('DOMContentLoaded', renderCards);
  </script>
</body>
</html>

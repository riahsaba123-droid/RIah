            <button onclick="toggleModal('modalQR', true)" class="btn btn-outline btn-sm" style="color:#000;">Scan QR WhatsApp</button>
          </div>
          <form onsubmit="sendMsg(event)" style="display:flex; flex-direction:column; gap:10px;">
            <input type="text" id="fn" placeholder="Nama Lengkap" required style="padding:8px 12px; border-radius:6px; border:none;">
            <input type="email" id="fe" placeholder="Email" required style="padding:8px 12px; border-radius:6px; border:none;">
            <textarea id="fm" placeholder="Pesan / Kebutuhan" rows="3" required style="padding:8px 12px; border-radius:6px; border:none;"></textarea>
